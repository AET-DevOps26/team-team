# Copy to terraform.tfvars and edit values

project_name = "team-team"
environment  = "dev"
location     = "polandcentral"
vm_size      = "Standard_B4s_v2"

admin_username = "azureuser"

# Leave empty to auto-generate a key pair in ./ssh/, or point at an existing public key
# ssh_public_key_path = "~/.ssh/id_rsa.pub"
ssh_public_key_path = ""

# Lock SSH down to your IP for safety (find it via https://ifconfig.me)
# allowed_ssh_cidr = "1.2.3.4/32"
allowed_ssh_cidr = "*"
